{
  "name": "tetherterm",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "@types/bun": "1.4.5",
      "varlock": "1.25.0",
      "better-auth": "1.7.22",
      "evlog": "^2.35.1",
      "ai": "^7.0.170",
      "lucide-react": "^1.72.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "@tanstack/react-form": "^1.33.5",
      "@polar-sh/better-auth": "^2.1.4",
      "@polar-sh/sdk": "^1.1.0",
      "@ai-sdk/react": "^4.0.174",
      "@tailwindcss/postcss": "^4.3.5",
      "@types/node": "^26.6.6",
      "@types/react-dom": "^19.3.0",
      "tailwindcss": "^4.3.5",
      "@better-auth/expo": "1.7.22"
    }
  },
  "scripts": {
    "build": "bun run --cwd apps/server build",
    "check": "ultracite check",
    "check-types": "bun run --cwd apps/server check-types",
    "dev": "bun run --cwd apps/server dev",
    "dev:server": "bun run --cwd apps/server dev",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "fix": "ultracite fix",
    "postinstall": "bun run env:generate",
    "start": "bun run --cwd apps/server start",
    "terminal:http": "bun run ./apps/server/src/http.ts",
    "terminal:stdio": "bun run ./apps/server/src/stdio.ts",
    "test": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:e2e": "bun test ./apps/server/test/e2e",
    "test:integration": "bun test ./apps/server/test/pty-spike.test.ts ./apps/server/test/transport-boot.test.ts ./apps/server/test/integration",
    "test:unit": "bun test ./apps/server/test/unit",
    "verify:coverage": "bun test --coverage ./apps/server/test"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@2.0.1"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tetherterm/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3",
    "ultracite": "8.0.0",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": "1.4.5"
  }
}
