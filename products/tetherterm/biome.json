{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "!!**/node_modules",
      "!!**/dist",
      "!!**/.turbo",
      "!!apps/web",
      "!!apps/native",
      "!!apps/extension",
      "!!apps/fumadocs",
      "!!apps/docs",
      "!!packages/auth",
      "!!packages/db",
      "!!packages/ui",
      "!!evidence",
      "!!.agents",
      "!!.claude",
      "!!.cursor",
      "!.mcp.json",
      "!bts.jsonc",
      "!skills-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab"
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "globals": ["Bun"],
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
