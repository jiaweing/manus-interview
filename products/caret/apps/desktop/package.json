{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "build:helper": "bun native/scripts/build.ts",
    "dev": "electron-vite build && electron-vite dev",
    "fixture:overlay": "bun run build && bun scripts/overlay-fixture.ts",
    "helper:snapshot": "bun native/scripts/test.ts --snapshot",
    "test:helper-protocol": "bun native/scripts/test.ts",
    "test:ipc-boundary": "bun test tests/ipc-boundary.test.ts",
    "test:model-manager": "bun test tests/model-manager.test.ts",
    "test:overlay": "bun test tests/overlay-state.test.ts",
    "test:tray-hotkey": "bun test tests/tray-hotkey.test.ts",
    "test:windows:clipboard-policy": "bun native/scripts/clipboard-policy.ts",
    "test:windows:helper-protocol": "bun native/scripts/test.ts --windows",
    "test:windows:paste-target": "bun native/scripts/paste-target.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:helper": "tsc --noEmit -p native/tsconfig.json",
    "typecheck:overlay": "tsc --noEmit -p tsconfig.overlay.json",
    "verify:helper-secrets": "bun native/scripts/check-secrets.ts",
    "verify:overlay-secrets": "bun scripts/overlay-secrets.ts",
    "verify:tray-secrets": "bun scripts/verify-tray-secrets.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-vite": "^6.0.0",
    "playwright": "^1.65.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
