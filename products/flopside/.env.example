# Optional product-root .env. No credentials or services required.
# Production: ONE Hono/Bun listener serves Next export AND /api/ws on WEB_PORT.
# Dev: Next on WEB_PORT, Hono/Bun on SERVER_PORT. #28 builder uses 3280/3281.
WEB_PORT=3000
SERVER_PORT=3001
# WEB_PORT (prod) / SERVER_PORT (dev) fall back to PORT, then 3000 / 3001.
HOST=127.0.0.1
# Optional DEV-only browser-safe server origin; otherwise derived from HOST/SERVER_PORT.
# Production ignores this value and always connects to the page origin.
# NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3001
# Optional comma-separated exact allowed browser origins (for TLS reverse proxy/dev).
# Same request origin is allowed automatically. Missing/disallowed Origin is denied.
# ALLOWED_ORIGINS=https://flopside.example
# E2E_BASE_URL=http://127.0.0.1:3000 (optional already-running production build)
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium (optional fallback)
# Mongo, Better Auth, Polar, AI, native and WXT remain dormant.
