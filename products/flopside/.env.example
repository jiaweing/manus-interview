# Optional: copy to .env at this product root. No credentials are required.
# Defaults: web http://127.0.0.1:3000, Hono http://127.0.0.1:3001.
# Builder #27 uses WEB_PORT=3270 SERVER_PORT=3271 to avoid shared-sandbox collisions.
WEB_PORT=3000
SERVER_PORT=3001
# SERVER_PORT falls back to PORT if present, then 3001.
# HOST=0.0.0.0 exposes both listeners when needed; default is loopback.
HOST=127.0.0.1
# Optional browser-safe endpoint for future room-client work (not used at this milestone).
NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3001
# Mongo, Better Auth, Polar, Google/AI, native and WXT are dormant.
