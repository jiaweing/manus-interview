{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --target bun --outdir dist",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "env:generate": "varlock codegen",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@ai-sdk/devtools": "^1.0.73",
    "@ai-sdk/google": "^4.0.118",
    "@flopside/auth": "workspace:*",
    "@flopside/db": "workspace:*",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "evlog": "catalog:",
    "hono": "^4.13.18",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@flopside/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3"
  }
}
