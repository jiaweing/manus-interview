{
  "name": "flopside",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "@types/bun": "^1.4.4",
      "varlock": "1.25.0",
      "better-auth": "1.7.22",
      "evlog": "^2.35.1",
      "ai": "^7.0.170",
      "lucide-react": "^1.72.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "@tanstack/react-form": "^1.33.5",
      "@polar-sh/better-auth": "^2.1.4",
      "@polar-sh/sdk": "^1.1.0",
      "@ai-sdk/react": "^4.0.174",
      "@tailwindcss/postcss": "^4.3.5",
      "@types/node": "^26.6.6",
      "@types/react-dom": "^19.3.0",
      "tailwindcss": "^4.3.5",
      "@better-auth/expo": "1.7.22"
    }
  },
  "scripts": {
    "build": "bun run --cwd apps/web build && bun run --cwd apps/server build",
    "check": "bun run lint",
    "check-types": "bun run typecheck",
    "dev": "bun run scripts/run-apps.ts dev",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "fix": "biome check --write .",
    "lint": "biome check .",
    "start": "bun run scripts/run-apps.ts start",
    "test": "bun test",
    "typecheck": "bun run --cwd apps/web check-types && bun run --cwd apps/server check-types && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@flopside/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3",
    "ultracite": "8.0.0",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.5"
}
