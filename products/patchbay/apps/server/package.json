{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "patchbay": "bun run --no-env-file src/cli.ts",
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@ai-sdk/devtools": "^1.0.73",
    "@ai-sdk/google": "^4.0.118",
    "@patchbay/auth": "workspace:*",
    "@patchbay/db": "workspace:*",
    "ai": "catalog:",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-auth": "catalog:",
    "evlog": "catalog:",
    "hono": "^4.13.18",
    "semver": "^7.8.6",
    "smol-toml": "^1.9.1",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@patchbay/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/semver": "^7.8.0",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3"
  }
}
