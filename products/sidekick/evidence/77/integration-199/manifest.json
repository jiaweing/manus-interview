{
  "manifest_version": 3,
  "name": "Sidekick",
  "description": "Sidekick: supervised Chrome side-panel agent",
  "version": "0.0.0",
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "96": "icon/96.png",
    "128": "icon/128.png"
  },
  "action": {
    "default_title": "Open Sidekick"
  },
  "host_permissions": [
    "https://8787-iew64p70hi5e7f4kbrn79-5b0a26b0.sg2.manus.computer/*"
  ],
  "minimum_chrome_version": "116",
  "optional_host_permissions": [
    "https://en.wikipedia.org/*",
    "https://httpbin.org/*"
  ],
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
