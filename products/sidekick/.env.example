# Server scripts explicitly load products/sidekick/.env; it is gitignored.
NODE_ENV=development
PORT=8787
# Required server-only static bearer token: generate privately, never commit.
SIDEKICK_DEMO_TOKEN=
# Public origin. Production requires HTTPS (even for localhost).
SIDEKICK_PROXY_URL=http://localhost:8787
# Limit counts actual UTF-8 bytes, including streamed/chunked bodies.
SIDEKICK_MAX_BODY_BYTES=131072
# Shared fixed-window budget per server process for the single demo token.
SIDEKICK_RATE_LIMIT_MAX_REQUESTS=60
SIDEKICK_RATE_LIMIT_WINDOW_MS=60000
# Only this public URL is exposed to the extension by WXT. Match the server URL.
WXT_SIDEKICK_PROXY_URL=http://localhost:8787
# Server-only OpenRouter settings. Never prefix keys or tokens with WXT_.
# Leave blank until a private key is supplied; the turn endpoint returns 501.
OPENROUTER_API_KEY=
# One fixed model for all clients. The PRD default is an unverified candidate.
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
