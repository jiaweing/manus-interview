{
  "name": "glassroom",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "@types/bun": "^1.4.4",
      "evlog": "^2.35.1",
      "lucide-react": "^1.72.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "@tailwindcss/postcss": "^4.3.5",
      "@types/node": "^26.6.6",
      "@types/react-dom": "^19.3.0",
      "tailwindcss": "^4.3.5"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "dev:https": "bun run scripts/https.ts dev",
    "fix": "ultracite fix",
    "start:https": "bun run scripts/https.ts start",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@glassroom/config": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@types/bun": "catalog:",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3",
    "ultracite": "8.0.0"
  },
  "packageManager": "bun@1.4.5"
}
