# Glassroom has no required secrets. All values are optional overrides.
# Public HTTPS port of the single origin (default 3443)
PUBLIC_PORT=3443
# Loopback port of the Next.js server behind the HTTPS front (default 3001)
NEXT_INTERNAL_PORT=3001
# Production: paths to the TLS certificate and key for the configured origin.
# Unset in local development: a self-signed localhost certificate is generated in .certs/.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Optional AI calls (none are used by this product). If ever needed, go through OpenRouter:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
